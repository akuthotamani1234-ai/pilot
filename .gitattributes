# Text files are stored with LF in the repository and checked out with the PC's line endings
* text=auto

# Windows scripts must keep CRLF: cmd.exe can misread labels and blocks in a .bat file with LF endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never changed by git
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.xlsx binary
*.zip binary
*.sqlite binary
