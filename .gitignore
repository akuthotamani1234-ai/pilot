# Secrets: your settings and API keys (.env.example is the empty template that IS shared)
.env
.env.*
!.env.example

# Local data written by runs: never part of a release
runs/
baseline/*
!baseline/.gitkeep
workspace/*
!workspace/.gitkeep
accounts/
logs/
schedules.json
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Python environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Playwright output when the generated tests are run by hand outside a run folder
test-results/
playwright-report/

# Editors and the operating system
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
# Excel's lock file while test_cases.xlsx is open
~$*

# old snapshot folder (no longer used)
.snapshots/

# Workspace-only privacy preferences and generated MCP paths
.private/
mcp-config.local.json

# Downloaded demo applications and browser-driver binaries
demo-apps/*.apk
tools/chromedriver/*.exe
tools/chromedriver/chromedriver

# Local Android / Gradle machine state
tests/android_demo/local.properties
tests/android_demo/.gradle/
tests/android_demo/**/build/
*.iml

# Local scratch / agent artifacts (never ship)
artifacts/
/opt/cursor/
.claude/
.cursor/
*.log
deep_validation/**/*.txt
deep_validation/**/*.log
!deep_validation/**/*.md
!deep_validation/README.md

# Node (if a demo or tooling adds it later)
node_modules/
npm-debug.log*
yarn-error.log*

# OS / packaging leftovers
*.tmp
*.temp
*.bak
*.orig
.Python
deep_validation/live_runs/*.txt
deep_validation/phase1-linux-pytest-nonslow-serial.txt

# ephemeral validation scratch
deep_validation/**/pytest-tmp/
deep_validation/**/*-pytest-tmp/
