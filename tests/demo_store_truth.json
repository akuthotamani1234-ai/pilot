{
  "about": "Everything that is really on DemoStore (tests/demo_store.py), to measure what the agent finds and misses. 'detect' = words that show the feature was seen on the page; 'test' = words a test case about it contains; 'expect' = the correct outcome (verified / blocked = protected, never run / needs_login = needs a test account); 'bug' = the planted bug (DemoStore(bugs=True)) its test must catch.",
  "pages": [
    {"path": "/", "auth": false},
    {"path": "/about", "auth": false},
    {"path": "/deals", "auth": false},
    {"path": "/weekend", "auth": false, "how": "only linked from deals that load when you scroll down"},
    {"path": "/signin", "auth": false},
    {"path": "/register", "auth": false},
    {"path": "/dashboard", "auth": true},
    {"path": "/shop", "auth": true},
    {"path": "/product/{id}", "auth": true, "how": "40 pages of one pattern: a sample is enough"},
    {"path": "/cart", "auth": true},
    {"path": "/wishlist", "auth": true},
    {"path": "/compare", "auth": true, "how": "its link appears only after 'Add to compare'"},
    {"path": "/checkout", "auth": true},
    {"path": "/orders", "auth": true},
    {"path": "/orders/{id}", "auth": true},
    {"path": "/orders/{id}/tracking", "auth": true},
    {"path": "/account", "auth": true},
    {"path": "/addresses", "auth": true}
  ],
  "inaccessible": [{"path": "/admin", "status": 403}],
  "never": ["POST /order", "GET /buy", "GET /logout", "POST /account", "POST /addresses", "POST /register"],
  "features": [
    {"id": "login.wrong_password", "page": "/signin", "detect": "email|continue|password", "test": "wrong password"},
    {"id": "shop.search", "page": "/shop", "detect": "search", "test": "search (finds|for ')", "bug": "search_wrong_hit"},
    {"id": "shop.search_nothing", "page": "/shop", "detect": "search", "test": "doesn't exist|does not exist|no results",
     "bug": "search_wrong_hit"},
    {"id": "shop.suggestions", "page": "/shop", "detect": "suggest", "test": "suggest"},
    {"id": "shop.filter", "page": "/shop", "detect": "filter|categor", "test": "filter"},
    {"id": "shop.sort", "page": "/shop", "detect": "sort", "test": "sort", "bug": "sort_price"},
    {"id": "shop.pagination", "page": "/shop", "detect": "pagination|next", "test": "'next'|next page|other items"},
    {"id": "product.size", "page": "/product/{id}", "detect": "size", "test": "size"},
    {"id": "product.quantity", "page": "/product/{id}", "detect": "quantity", "test": "quantit", "bug": "qty_below_min"},
    {"id": "product.add_to_cart", "page": "/product/{id}", "detect": "add to cart", "test": "add to cart"},
    {"id": "product.wishlist", "page": "/product/{id}", "detect": "wishlist", "test": "wishlist", "bug": "wishlist_error"},
    {"id": "product.compare", "page": "/product/{id}", "detect": "compare", "test": "compare"},
    {"id": "product.buy_now", "page": "/product/{id}", "detect": "buy now", "test": "buy now", "expect": "blocked"},
    {"id": "cart.totals", "page": "/cart", "anywhere": true, "detect": "total", "test": "total", "bug": "cart_total"},
    {"id": "cart.remove_own", "page": "/cart", "anywhere": true, "detect": "remove", "test": "remove"},
    {"id": "checkout.place_order", "page": "/checkout", "detect": "place order", "test": "place order", "expect": "blocked"},
    {"id": "orders.detail", "page": "/orders", "detect": "order", "test": "order"},
    {"id": "orders.tracking", "page": "/orders/{id}", "detect": "track", "test": "track"},
    {"id": "account.validation", "page": "/account", "detect": "email", "test": "empty|required|invalid email"},
    {"id": "addresses.validation", "page": "/addresses", "detect": "street", "test": "empty|required"},
    {"id": "register.validation", "page": "/register", "detect": "email", "test": "empty|required|invalid email"},
    {"id": "deals.help_panel", "page": "/deals", "detect": "next tip|mark as read", "test": "next tip|mark as read"},
    {"id": "deals.favourites_visitor", "page": "/deals", "detect": "favourites", "test": "favourites", "expect": "needs_login"},
    {"id": "deals.notify", "page": "/deals", "detect": "notify", "test": "notify", "bug": "dead_button"}
  ],
  "bugs": {
    "sort_price": {"what": "sort 'Price: low to high' is not sorted", "signature": "should sort by price"},
    "cart_total": {"what": "the cart total ignores the quantity", "signature": "cart total"},
    "search_wrong_hit": {"what": "search also shows items that don't match",
                         "signature": "don't match|does not exist still shows"},
    "qty_below_min": {"what": "the product's '-' goes below 1", "signature": "must stop at the minimum"},
    "wishlist_error": {"what": "'Add to wishlist' fails with an error message", "signature": "went wrong"},
    "dead_button": {"what": "'Notify me' does nothing", "signature": "no visible response"}
  }
}
