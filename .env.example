# Copy this file to .env and fill it in.   (Windows: copy .env.example .env)

# ---- AI (pick ONE). The web UI also lets you choose per run.
# ollama = runs locally, free, no data leaves your machine (DEFAULT - use it when security matters)
#          install from ollama.com, then:  ollama pull llama3.1
# gemini = free tier available | openai / anthropic = paid | none = rule-based, no AI
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1             # optional: model name (default per provider)
# LLM_PRICE_INPUT_PER_M=0.30     # optional: override the $ per 1M tokens used in the cost report
# LLM_PRICE_OUTPUT_PER_M=2.50
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
# RECORD_VIDEO=true             # save a video of the test browsers in runs/<run>/videos (large files)
# OLLAMA_NUM_CTX=16384          # how much text Ollama reads per request (its own default cuts long prompts)
LLM_TIMEOUT=240               # seconds to wait for one cloud AI answer (a timeout is retried once, then rules are used)
VISION=auto                   # the AI looks at screenshots (every page; before / after of each failed test): auto = with a cloud AI or an Ollama vision model, on, off
# VISION_MAX_FAILURES=60        # failed tests the AI looks at per run (each costs about 2 pictures)

# ---- Crawling limits
# Thorough exploration (UI preset "Thorough"): leave MAX_PAGES=0 so discovery uses HARD_PAGE_CAP,
# raise MAX_INTERACTIONS_PER_PAGE (UI uses 50+), keep EXPLORE_REPEATED_CONTROLS=true for menus/pagination.
# Unvisited URLs are still listed when the page or time budget stops the crawl — that is expected, not a silent miss.
MAX_PAGES=0
MAX_DEPTH=0
HARD_PAGE_CAP=500             # never more pages than this, even with MAX_PAGES=0 (some sites generate endless addresses)
CRAWL_TIME_LIMIT_MIN=30       # stop exploring after this many minutes (the report says so)
RUN_TIME_LIMIT_MIN=90         # the WHOLE run: after this it stops and writes the report with what was done (0 = no limit)
MAX_INTERACTIONS_PER_PAGE=15  # safe clicks per page to find pages that only a button leads to (Thorough UI uses 50)
PATTERN_SAMPLES=0             # 0 = visit every discovered route/item; >0 samples pages per address pattern (use 2–5 on huge catalogs)
MAX_TEST_CASES=300            # test cases per run, most important first (pages behind the login first)
EXPLORE_REPEATED_CONTROLS=false  # true = also try repeated menu/pagination controls (Thorough UI sets true)
TEST_RETRIES=0                # retries of failed tests (0 = each test runs once; set to 1 to detect flaky tests)
LLM_BUDGET_USD=2              # AI cost limit per run; after that the built-in rules are used
PAGE_TIMEOUT_MS=20000         # how long one page may take to open
CRAWL_SCOPE=auto              # auto = decide from the link (home -> entire website, site.com/shop -> limited pages, deeper -> specific page); or force site / section / page
ALLOWED_HOSTS=                # extra hosts that belong to the app, comma-separated (e.g. auth.example.com, *.example.com). Nothing else is ever opened.
EXCLUDE_PATHS=                # paths never to open, comma-separated (e.g. /admin, /billing)
TEST_ENVIRONMENT=test         # production / test: nothing is ever sent (forms are checked with a write guard) |
                              # staging (your test copy): forms ARE sent, records created -> edited -> deleted
ALLOW_ACTIONS=                # staging only: also allow delete, logout, password, pay (comma-separated)
TEST_PAYMENT=0                # staging + ALLOW_ACTIONS=pay: 1 = the payment provider is in its test mode
CONFIRM_WRITES=0              # staging on a host without staging/test/qa/dev/uat/preview/sandbox in it: 1 = I confirm
REVIEW=auto                   # human review of the planned tests before scripts are written: auto = on staging, on, off
REVIEW_TIMEOUT_S=900          # how long the run waits for your review answers (then it goes on with the rules)
MAX_REQUESTS_PER_SEC=2        # polite speed on a PUBLIC website (0 = no limit; it slows down by itself after HTTP 429/503)
SECTION=                      # only this part of a very large website, e.g. /electronics (same as --section)
INCREMENTAL=false             # true + a baseline: fully test only new / changed pages, smoke-check the rest
MOBILE_CHECK=true             # every page also at phone width (390 x 844): phone-only controls + layout problems
JS_COVERAGE=auto              # Chromium: how much of the site's own JavaScript was used (auto = staging / a site on this PC; on; off)
CHECK_EXTERNAL_LINKS=true     # false = never contact other websites (their links are then not checked)
QA_REQUIREMENTS=              # optional: your workflows / expected results / user roles in plain words (given to the AI)
HEADLESS=true                 # false = show the browser live while testing, true = hidden (faster)
SLOW_MO_MS=0                  # slow motion: pause (ms) after every click/type so you can follow; 0 = full speed
HUMAN_WAIT_S=180              # visible browser: how long to wait for YOU to type a one-time code / solve a CAPTCHA (0 = never)

# ---- Optional input robustness tests (off by default): try boxes with empty, long, symbols, emoji, etc.
# These values are typed but never submitted. Core functional tests still cover relevant user behaviors.
DATA_TESTS=false
DATA_MAX_FIELDS=4             # input boxes per page that get test data

# ---- Login forms (optional): a TEST account (never a real one). Without it only "wrong password is rejected" is tested.
TEST_USERNAME=
TEST_PASSWORD=
TEST_TOTP_SECRET=             # 2-step login with an authenticator app: the test account's setup key (or otpauth://...)
                              # - the login code is made from it like the app makes it. E-mail / SMS codes need a person.
# Several roles (optional): role:username:password, comma-separated. The first one is the main account when
# TEST_USERNAME is empty; every other role is checked against the main role's pages (allowed / refused).
# e.g. TEST_ACCOUNTS=admin:admin@test.example:Secret1,viewer:viewer@test.example:Secret2
TEST_ACCOUNTS=
# No test account above and the website has a login? Only if you allow it (here, or the tick in the web UI), the
# tester signs up ONCE on the site's sign-up page with fake test data (agentic.qa.<number>@example.com), saves it
# ENCRYPTED in accounts/<site>.json (Windows DPAPI) and reuses it next time. Creating an account changes the website.
AUTO_REGISTER=false
# Only when the tester can't find the login by itself:
LOGIN_URL=                        # the login page, if it is not linked from the start page
LOGIN_USER_SELECTOR=              # e.g. #email
LOGIN_PASSWORD_SELECTOR=          # e.g. #password
LOGIN_SUBMIT_SELECTOR=            # e.g. button[type=submit]   (empty = press Enter)
LOGIN_SUCCESS_TEXT=               # text only shown when logged in, e.g. Dashboard
LOGIN_SUCCESS_URL=                # part of the address after login, e.g. /dashboard

# ---- Speed: how many browsers run the tests at the same time (always 1 when you watch in Chrome)
TEST_WORKERS=4

# ---- Self-healing: how many fix-and-rerun rounds
MAX_HEAL_ROUNDS=2
REUSE_TESTS=false             # true = regression run: run the last run's scripts again instead of writing new ones

# ---- Sandbox for the generated tests (own process, no API keys, network + file guard, Windows Job Object)
TEST_TIMEOUT_S=180            # one test may take at most this long, then it is stopped
SUITE_TIMEOUT_S=3600          # the whole test run (tests not run in time are reported as "not run")
SANDBOX_MEMORY_MB=6144        # all test browsers + pytest together (Windows)
SANDBOX_MAX_PROCESSES=256     # (Windows)

# ---- Visual check: every page's look (desktop + phone width) compared with its APPROVED look (baseline/<site>/visual/)
# The first run saves the look; later runs show what changed (missing / moved / overlapping elements, the picture) for
# you to judge - never a bug by itself. A changed look is approved in the app ("Approve the new look").
VISUAL_CHECK=true             # false = no visual check
VISUAL_PIXEL_PERCENT=1        # report a picture when more than this % of it changed
VISUAL_MOVE_PX=12             # report an element that moved / changed size by more than this
VISUAL_MAX_PAGES=100          # pages compared per run
VISUAL_AUTO_APPROVE=false     # true = this run's look becomes the approved look (after an intended redesign)

# ---- Integrations (all optional - nothing is sent unless it is filled in). Only application defects are sent,
# never test-script problems, inconclusive results or visual changes.
SLACK_WEBHOOK_URL=            # Slack "Incoming Webhook" address: one message when a run finds significant defects
SLACK_MIN_SEVERITY=high       # critical | high | medium | low
JIRA_URL=                     # https://your-company.atlassian.net
JIRA_EMAIL=                   # the Jira account that creates the issues
JIRA_API_TOKEN=               # id.atlassian.com -> Security -> API tokens
JIRA_PROJECT=                 # the project key, e.g. QA
JIRA_ISSUE_TYPE=Bug
JIRA_MIN_SEVERITY=high        # one issue per application defect at or above this (the same problem is never sent twice)
JIRA_MAX_ISSUES=10            # per run
WEBHOOK_TOKEN=                # set it to let a deploy script start a run: POST http://127.0.0.1:8000/api/hooks/run
                              #   header X-QA-Token: <token>, body {"url": "https://..."}  (or GitHub's signed webhook)
WEBHOOK_TEST_URL=             # the website a hook without an address tests
# GitHub Actions: .github/workflows/blow-ai.yml tests the website after a push / a deployment (see the file)

# ---- Release gates: the verdict is calculated from these rules, never by the AI
GATE_BLOCK_SEVERITY=high          # website bugs at or above this severity -> Not Ready (critical | high | medium)
GATE_MAX_AUTOMATION_ERRORS=0      # default: any unresolved script/locator error -> Insufficient Evidence
GATE_LOGIN_REQUIRED=true          # app behind a login that could not be tested -> Insufficient Evidence (false = only a risk)
GATE_MIN_PUBLIC_PAGES=2           # fewer usable public pages than this (and no login) -> Insufficient Evidence

# ---- Code input (GitHub link / local folder)
GITHUB_TOKEN=                 # PRIVATE repos, and "Apply fixes" Pull Requests (needs Contents + Pull requests: write)
SERVER_START_TIMEOUT=180      # seconds to wait for the app to start
START_CMD=                    # override, e.g.  npm run dev -- --port {port}
APP_PORT=0                    # 0 = pick a free port automatically

# ---- Web UI
UI_PORT=8000                  # the UI's port on this PC (http://127.0.0.1:8000); the next free one if it is taken
