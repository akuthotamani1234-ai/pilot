{
  "version": 1,
  "test_environment": false,
  "flows": [
    {
      "id": "login",
      "title": "Approved account reaches its expected screen",
      "approved": false,
      "authentication": true,
      "steps": [
        {
          "action": "fill",
          "locator": {
            "strategy": "resource_id",
            "value": "com.example.app:id/username"
          },
          "secret_ref": "BLOWAI_SECRET_LOGIN_USERNAME"
        },
        {
          "action": "fill",
          "locator": {
            "strategy": "resource_id",
            "value": "com.example.app:id/password"
          },
          "secret_ref": "BLOWAI_SECRET_LOGIN_PASSWORD"
        },
        {
          "action": "tap",
          "locator": {
            "strategy": "resource_id",
            "value": "com.example.app:id/login"
          },
          "purpose": "test_form"
        },
        {
          "action": "assert_screen",
          "value": "Dashboard"
        }
      ]
    }
  ]
}
